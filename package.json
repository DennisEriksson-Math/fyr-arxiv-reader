{
  "name": "fyr-arxiv-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A standalone mathematics paper reader, adapted from Fyr.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "local": "npm run build && python3 scripts/local_bridge.py"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^1.31.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
